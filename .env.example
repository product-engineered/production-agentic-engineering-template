# .env.example
#
# This file is committed to version control as a reference template.
# NEVER put production credentials, API keys, or secrets in this file.
# Doing so may provide AI agents with the ability to mutate production
# state without oversight. Dev and staging environments should be used.
# Production keys must be set via your deployment platform's secret manager
# (e.g. Vercel environment variables, AWS Secrets Manager), not stored here.
#
# To get started locally:
#   cp .env.example .env.local
# .env.local is gitignored and safe for real values during development.

# Example: third-party API key
THIRD_PARTY_API_KEY=your-api-key-here
